[submodule "deps/glade"]
	path = deps/glade
	url = https://github.com/batonez/glade.git
[submodule "deps/PerlinNoise"]
	path = deps/PerlinNoise
	url = https://github.com/batonez/PerlinNoise.git
[submodule "deps/lodepng"]
	path = deps/lodepng
	url = https://github.com/batonez/lodepng.git
[submodule "deps/sha1"]
	path = deps/sha1
	url = https://github.com/batonez/sha1.git
[submodule "deps/assimp"]
	path = deps/assimp
	url = https://github.com/batonez/assimp
[submodule "deps/glew"]
	path = deps/glew
	url = https://github.com/batonez/glew.git
[submodule "deps/glfw"]
	path = deps/glfw
	url = https://github.com/batonez/glfw.git
[submodule "deps/zlib"]
	path = deps/zlib
	url = https://github.com/batonez/zlib.git
[submodule "deps/freetype"]
	path = deps/freetype
	url = https://github.com/batonez/freetype.git
[submodule "deps/bullet3"]
	path = deps/bullet3
	url = https://github.com/batonez/bullet3.git
	update = none
[submodule "deps/libccd"]
	path = deps/libccd
	url = https://github.com/batonez/libccd.git
[submodule "deps/imgui"]
	path = deps/imgui
	url = https://github.com/ocornut/imgui
[submodule "deps/enet"]
	path = deps/enet
	url = https://github.com/batonez/enet
	ignore = untracked
[submodule "deps/rapidjson"]
	path = deps/rapidjson
	url = https://github.com/Tencent/rapidjson
